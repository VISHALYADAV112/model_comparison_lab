# Optional password protection. Set both values or neither.
MODEL_LAB_USER=
MODEL_LAB_PASSWORD=

# Default is private localhost. Use 0.0.0.0 only on a trusted LAN/firewall.
MODEL_LAB_HOST=127.0.0.1
MODEL_LAB_PORT=7860

# Keep Hugging Face's default home so an existing `hf auth login` is reused.
# On a new SSH server, run `hf auth login` there once or export HF_TOKEN.
RF_HOME=models/rfdetr
YOLO_CONFIG_DIR=.cache/ultralytics

